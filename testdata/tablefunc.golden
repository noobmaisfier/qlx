-- generate_series in FROM
SELECT "s"."x" FROM "pg_catalog"."generate_series"($1::int8, $2::int8) AS "s" ("x")

-- unnest with ordinality
SELECT "u"."x", "u"."n" FROM "pg_catalog"."unnest"(CAST($1 AS int8[])) WITH ORDINALITY AS "u" ("x", "n")

-- unnest joined laterally to a table
SELECT "users"."id", "u"."x" FROM "public"."users" CROSS JOIN "pg_catalog"."unnest"(CAST($1 AS int8[])) WITH ORDINALITY AS "u" ("x", "n")

-- named window reused
SELECT row_number() OVER "w" AS "rn", sum("orders"."total") OVER ("w" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "run" FROM "public"."orders" WINDOW "w" AS (PARTITION BY "orders"."user_id" ORDER BY "orders"."id")

